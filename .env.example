# Local state directory. NEVER point this at a public/shared directory for private clips.
VSEARCH_DATA_DIR=.vsearch
# DEBUG, INFO, WARNING, ERROR
VSEARCH_LOG_LEVEL=INFO
# Emits structured JSON diagnostics; excludes raw media content and user queries.
VSEARCH_JSON_LOGS=false
# CLI tool path. Must resolve to ffprobe for ingest milestones.
VSEARCH_FFPROBE_PATH=ffprobe
# Maximum uploaded file size; enforcement follows in M6.
VSEARCH_MAX_UPLOAD_BYTES=104857600
# Caption API spending is disabled unless explicitly configured for M4.
VSEARCH_CAPTION_BUDGET_USD=0
